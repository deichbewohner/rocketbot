# Rocket.Chat Bot Configuration
# Copy this file to .env and fill in your credentials
#
# To generate Personal Access Tokens:
# 1. Log in to Rocket.Chat as the bot user
# 2. Go to My Account → Personal Access Tokens
# 3. Create a new token with a descriptive name
# 4. Copy the token and userId

# Bot 1
BOT1_SLUG=alerts
BOT1_URL=https://chat.example.com
BOT1_USER_ID=abc123xyz
BOT1_TOKEN=your-personal-access-token-here
BOT1_GENERATOR_TYPE=webhook
BOT1_WEBHOOK_URL=https://your-webhook.example.com/webhook
BOT1_WEBHOOK_AUTH=Bearer your-optional-auth-token
BOT1_STREAMED_OUTPUT=true
BOT1_PARSER_TYPE=n8n
BOT1_THREAD_DEFAULT=false
BOT1_STATUS_MESSAGE=Alerts Bot Ready

# Bot 2
BOT2_SLUG=notifications
BOT2_URL=https://chat.example.com
BOT2_USER_ID=def456uvw
BOT2_TOKEN=your-personal-access-token-here
BOT2_GENERATOR_TYPE=webhook
BOT2_WEBHOOK_URL=https://your-webhook.example.com/webhook
BOT2_WEBHOOK_AUTH=Bearer your-optional-auth-token
BOT2_STREAMED_OUTPUT=true
BOT2_PARSER_TYPE=n8n
BOT2_THREAD_DEFAULT=false

# Bot 3 (optional - add more as needed)
# BOT3_SLUG=support-bot
# BOT3_URL=https://chat.other.com
# BOT3_USER_ID=ghi789rst
# BOT3_TOKEN=your-personal-access-token-here
# BOT3_GENERATOR_TYPE=webhook
# BOT3_WEBHOOK_URL=https://your-webhook.example.com/webhook
# BOT3_WEBHOOK_AUTH=Bearer your-optional-auth-token
# BOT3_STREAMED_OUTPUT=true
# BOT3_PARSER_TYPE=n8n
# BOT3_THREAD_DEFAULT=false

# Configuration Options:
#
# Bot Identity:
# - SLUG: URL-safe identifier for the bot, used in HTTP API endpoints (REQUIRED)
#         Must be lowercase alphanumeric with hyphens (e.g., 'alerts', 'my-bot-1')
#         Must be unique across all configured bots
# - STATUS_MESSAGE: Custom status message displayed in Rocket.Chat (optional)
#                   If not set, no custom message is shown (uses Rocket.Chat default status)
#                   Example: "Alerts Bot Ready" or "Monitoring System Active"
#                   Note: If bot previously had a status message, removing this setting
#                         won't clear the old message. Clear it manually in Rocket.Chat UI.
#
# Response Generation:
# - GENERATOR_TYPE: Response generator backend (optional)
#                   Supported: "webhook" (default)
#                   Supported (preview): "opencode"
#
# OpenCode Generator Configuration (GENERATOR_TYPE=opencode):
# - OPENCODE_BASE_URL: OpenCode server base URL (optional)
#                      Default: http://127.0.0.1:4096
# - OPENCODE_AUTH: Optional Authorization header value (e.g. "Bearer ...")
# - OPENCODE_PERMISSION_MODE: How to handle permission prompts (optional)
#                            Supported: "allow" or "deny"
#                            Default: "deny" (safe)
#
# Webhook Generator Configuration (GENERATOR_TYPE=webhook):
# - WEBHOOK_URL: URL of the streaming webhook endpoint (REQUIRED)
# - WEBHOOK_AUTH: Optional Authorization header value (e.g., "Bearer token" or custom auth)
# - PARSER_TYPE: Stream parser type for webhook responses (REQUIRED)
#                Currently supported: "n8n" (n8n newline-delimited JSON format)
# - STREAMED_OUTPUT: Whether to edit messages as chunks arrive (true) or send once when complete (false)
#                    Default: true - enables live message updates
#
# Behavior Options:
# - THREAD_DEFAULT: Always reply in threads (true) or only with /thread command (false)
#                   Default: false
#                   When true: All replies are in threads (creates new thread for root messages)
#                   When false: Only creates threads when user includes "/thread" in their message

# HTTP API Server (optional - for programmatic bot triggers)
# Not internet-facing: bind to loopback or a private interface.
# Example (loopback):
# API_ADDR=127.0.0.1:8080

# Bot API Tokens (optional - only set for bots that need HTTP API access)
# If a bot doesn't have an API_TOKEN, it will NOT be accessible via HTTP API
# This allows you to selectively enable HTTP triggers per bot
# BOT1_API_TOKEN=your-api-token-for-bot1
# BOT2_API_TOKEN=your-api-token-for-bot2
# BOT3_API_TOKEN=your-api-token-for-bot3

# HTTP API Usage:
# POST /api/v1/bots/{slug}/send
# Header: Authorization: Bearer {BOT_API_TOKEN}
# Body: {"target": {"username|channel|roomId": "value"}, "text": "Message text"}
#
# Examples (using BOT1_SLUG=alerts):
#   - {"target": {"username": "alice"}, "text": "Hi"}           → Send DM to user alice
#   - {"target": {"channel": "general"}, "text": "Hi"}          → Send to channel general (# optional)
#   - {"target": {"roomId": "ROOMID123"}, "text": "Hi"}        → Send to room with ID ROOMID123
#
# Example API calls:
#   curl -X POST http://127.0.0.1:8080/api/v1/bots/alerts/send \
#        -H "Authorization: Bearer your-api-token" \
#        -H "Content-Type: application/json" \
#        -d '{"target": {"username": "alice"}, "text": "Alert: Server down!"}'
#
# Note: Target must specify exactly ONE of: username, channel, or roomId

# Network policy tips (optional but recommended):
# - Restrict egress to the Rocket.Chat host and your webhook endpoints only
#   (iptables/nftables, eBPF, or Kubernetes NetworkPolicy).
# - Restrict ingress to trusted callers if you enable API_ADDR.
